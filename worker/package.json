// worker/package.json
{
    "name": "wfh-platform-worker",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "db:create": "wrangler d1 create wfh-platform-db",
        "db:migrate": "wrangler d1 execute wfh-platform-db --file=./schema.sql",
        "db:seed": "wrangler d1 execute wfh-platform-db --file=./seed.sql",
        "secret:set": "wrangler secret put AUTH_SECRET"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "itty-router": "^4.0.27"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20241230.0",
        "wrangler": "^3.28.0"
    }
}